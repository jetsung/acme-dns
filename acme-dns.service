[Unit]
Description=Limited DNS server with RESTful HTTP API to handle ACME DNS challenges easily and securely (Rust implementation)
After=network.target

[Service]
User=acme-dns
Group=acme-dns
AmbientCapabilities=CAP_NET_BIND_SERVICE
WorkingDirectory=~
ExecStart=/usr/local/bin/acme-dns -c /etc/acme-dns/config.toml
Restart=on-failure

[Install]
WantedBy=multi-user.target
